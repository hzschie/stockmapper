extends main

block header
  .latest_news
    label News:
    a.article(target="stockmapper_news")
      .headline How the Smart Money Is Positioning Itself Now
      span.source Source: fool.com
      |  – 
      span.date 16 minutes ago

block panel_groups
  #all_etfs.group
    .box
      .picks
        .gainers.map
          label Gainers
          ul
        .losers.map
          label Losers
          ul
        .active.map
          label Active
          ul
      dl
        dt Num ETFs Up:
        dd.num_up &nbsp;
        dt Num ETFs Down:
        dd.num_down &nbsp;
        dt Volume Up:
        dd.volume_up &nbsp;
        dt Volume Down:
        dd.volume_down &nbsp;
  #etf_composite.group
    .box
      .picks
        .gainers.map
          label Gainers
          ul
        .losers.map
          label Losers
          ul
        .active.map
          label Active
          ul
      dl
        .quote
          .last_trade 237.50
          .change
            span.amount –1.95
            | &nbsp;(
            span.percent –0.83%
            | )
          .timestamp Last Updated: 
            span.value Nov 02, 03:00PM EST
        dt Previous Close:
        dd.previous 234.82
        dt Open:
        dd.open 233.05
        dt High:
        dd.high 237.40
        dt Low:
        dd.low 232.65

block append inspector_content
  .content.index
    .header
      h3.name Amit was here
      .sym SYM
    dl
      .left
        dt Avg. Vol.:
        dd.avg_volume 123,456
        dt Vol.:
        dd.volume 123,456
      .right
        dt Open:
        dd.open 12.34
        dt High:
        dd.high 12.34