extends main

block header
  .latest_news.ticker
    .arrows
      .up
      .down
    label News:
    .news
      a.article(target="stockmapper_news")
        span.title &nbsp;
        span.source &nbsp;
        |  – 
        span.date &nbsp;

block panel_groups
  #all_etfs.group
    .box
      .picks
        .gainers.map
          label Gainers
          ul
        .losers.map
          label Losers
          ul
        .active.map
          label Active
          ul
      .name All ETFs
      #global_last_update.timestamp Last Updated: 
        span.value &nbsp;
      dl
        dt Num ETFs Up:
        dd.num_up &nbsp;
        dt Num ETFs Down:
        dd.num_down &nbsp;
        dt Volume Up:
        dd.volume_up &nbsp;
        dt Volume Down:
        dd.volume_down &nbsp;
  #etf_composite.group
    .foreside_credit
      | Brought to you by 
      a(href="http://www.foreside.com/")
        img(src="/images/domains/foreside/etflabs_logo_inline.png?081212")
    .box
      .left
        .name
        .micro.graph
      .picks
        .gainers.map
          label Gainers
          ul
        .losers.map
          label Losers
          ul
        .active.map
          label Active
          ul
      .quote
        .last_trade &nbsp;
        .change
          span.amount &nbsp;
          | &nbsp;(
          span.percent &nbsp;
          | )
        .timestamp Last Updated: 
          span.value &nbsp;
      dl
        dt Previous Close:
        dd.previous &nbsp;
        dt Open:
        dd.open &nbsp;
        dt High:
        dd.high &nbsp;
        dt Low:
        dd.low &nbsp;
  .products(style="display:none;")
    #etf_50.group
      .box
        .name
        .quote
          .last_trade
          .change.green
            span.amount
            | &nbsp;(
            span.percent
            | )
    #etf_50ne.group
      .box
        .name
        .quote
          .last_trade.coming_soon COMING SOON
    #etf_25e.group
      .box
        .name
        .quote
          .last_trade.coming_soon COMING SOON
    #etf_25ne.group
      .box
        .name
        .quote
          .last_trade.coming_soon COMING SOON

block sort_options
  a(data-val="sym") Ticker Symbol
  a(data-val="chg") Percent Change
  a(data-val="vol") Volume

block append inspector_content
  .content.index
    .header
      h3.name Amit was here
      .sym SYM
    dl
      .left
        dt Avg. Vol.:
        dd.avg_volume 123,456
        dt Vol.:
        dd.volume 123,456
      .right
        dt Open:
        dd.open 12.34
        dt High:
        dd.high 12.34

block clustering_options
  a(data-val="none") None
  a(data-val="cluster") Classification
  
block analytics_code
  script(type='text/javascript')
    var _gaq = _gaq || [];
    _gaq.push(['_setAccount', 'UA-36604461-1']);
    _gaq.push(['_trackPageview']);

    (function() {
      var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
      ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
      var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
    })();