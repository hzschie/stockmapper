extends main

block header
  .latest_news.ticker
    .arrows
      .up
      .down
    label News:
    .news
      a.article(target="stockmapper_news")
        .title @nbsp;
        span.source Source: source.com
        |  – 
        span.date ? minutes ago

block panel_groups
  #all_etfs.group
    .box
      .picks
        .gainers.map
          label Gainers
          ul
        .losers.map
          label Losers
          ul
        .active.map
          label Active
          ul
      dl
        dt Num ETFs Up:
        dd.num_up &nbsp;
        dt Num ETFs Down:
        dd.num_down &nbsp;
        dt Volume Up:
        dd.volume_up &nbsp;
        dt Volume Down:
        dd.volume_down &nbsp;
  #etf_composite.group
    .box
      .picks
        .gainers.map
          label Gainers
          ul
        .losers.map
          label Losers
          ul
        .active.map
          label Active
          ul
      dl
        .quote
          .last_trade &nbsp;
          .change
            span.amount &nbsp;
            | &nbsp;(
            span.percent &nbsp;
            | )
          .timestamp Last Updated: 
            span.value &nbsp;
        dt Previous Close:
        dd.previous &nbsp;
        dt Open:
        dd.open &nbsp;
        dt High:
        dd.high &nbsp;
        dt Low:
        dd.low &nbsp;

block append inspector_content
  .content.index
    .header
      h3.name Amit was here
      .sym SYM
    dl
      .left
        dt Avg. Vol.:
        dd.avg_volume 123,456
        dt Vol.:
        dd.volume 123,456
      .right
        dt Open:
        dd.open 12.34
        dt High:
        dd.high 12.34

, "Commodity", "Fixed Income", "Equity", "Currency
block clustering_options
  a(data-val="none") None
  a(data-val="cluster") Classification
  //- a(data-val="equity") Equity
  //- a(data-val="global equity") Global Equity
  //- a(data-val="commodity") Commodity
  //- a(data-val="fixed income") Fixed Income
  //- a(data-val="currency") Currency
