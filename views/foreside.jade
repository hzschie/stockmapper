                        entry.title,
                      '</h4>',
                      '<div class="source">',
                        entry.source,
                      '</div>',
                    '</a>'
                  ].join('');
                }).join('');
                $('#other_news').html(html);
              },
              error:function(){console.log('error');},
              dataType: 'JSON'
            });
          
