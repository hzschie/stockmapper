!!!
html
  head
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0")
    meta(name="format-detection", content="telephone=no")
    link(rel="stylesheet", type="text/css", href="/stylesheets/domains/foreside.css")

    style(type="text/css")
      html {
        min-height:100%;
      }
      body {
        min-height:99%;
        color: #fff;
      }
      .wrapper {
        padding: 0 60px;
        min-height:100%;
        min-width:600px !important;
      }
      
      .about {
        padding-top:60px;
        display:inline-block;
      }
      
      .coming_soon {
        //- padding-top:40px;
        padding-left:5px;
        font-size:16px
      }
      
      .title {
        font-family: "Georgia", "Palatino", "Palatino Linotype", serif;
        font-weight:bold;
        font-size:60px;
        line-height:56px;
        margin-bottom:10px;
      }
      
      .info {
        //- padding-left:60px;
        margin-top:100px;
        font-size:14px;
        line-height:18px;
        color:#8ac;
      }
      
      .important {
        font-size:18px;
        line-height:22px;
        color:#fff;
      }
      
      .important a {
        color:#fff;
      }
      
      form.invite {
        text-align:right;
      }
      
      form input {
        vertical-align:middle;
      }
      
      form label {
        color:#8ac;
        display: inline-block;
        line-height: 24px;
        font-size:14px;
        vertical-align: middle;
        text-decoration: underline;
        cursor:pointer;
      }
      
      input.invitation_code {
        border-radius:16px;
        font-size:14px;
        font-weight:bold;
        width:110px;
        margin-left:10px;
        line-height:18px;
        height:18px;
        padding:1px 0 1px 8px;
      }
      
      .go {
        margin-left:4px;
        height:24px;
        width:24px;
        border-radius:16px;
        display:inline-block;
        background:#fff;
        color:#376279;
        padding:1px !important;
        border:none;
        text-align:center;
        font-weight:bold;
      }
      
      .closed input {
        display:none !important;
      }
      
      .reveal {
        display:inline-block;
        width:162px;
        white-space:nowrap;
        -webkit-transition:width .6s;
        overflow:hidden;
      }
      
      .closed .reveal {
        width:0;
      }
      
      .disclaimer {
        font-size:12px;
        position:absolute;
        bottom:12px;
        left:60px;
      }
      
      .disclaimer b {
        margin:0 4px;
      }
      
      @media (max-width:600px) {
        body {
          //- background: #f00;
        }
        
        body .wrapper {
          padding:10px;
          min-width:0 !important;
          width:auto;
        }
        
        .title {
          font-size:40px;
          line-height:38px;
        }
        
        .about {
          padding-top:20px;
        }
        
        .coming_soon {
          font-size:11px;
          padding-left:0;
          line-height:10px;
        }
        
        .important {
          font-size:12px !important ;
          line-height:12px;
        }
        
        .info {
          margin-top:40px;
        }
        
        .disclaimer {
          left:20px;
        }
        
        input.go {
          text-indent: -7px;
        }
        
        input.invitation_code {
          width:90px;
        }
        
        .reveal {
          width:142px;
        }
        
        form label {
          margin-left:5px;
          font-size:12px;
        }
        
        .disclaimer {
          position:relative;
          bottom:auto;
          left:10px;
          margin-top:20px;
        }
      }
body
  .wrapper
    .about
      .coming_soon COMING SOON
      .title ETFs of ETFs
      form.invite.closed(action="/login", method="post")
        label Have an invitation code?
        .reveal
          input(type="hidden", name="username", value="any")
          input(type="text", class="invitation_code", name="password", placeholder="Enter Code")
          input(type="submit", class="go", value="GO")
    
    .info
      | For more information, please call:<br>
      .important
        | Lee Morin<br>
        | (207) 553-7123
  
  .disclaimer Not for Public Use <b>•</b> For Demonstration Only
    
  // needs analytics
  script(type='text/javascript', src='/javascripts/lib/jquery-1.7.2.min.js')
  script(type="text/javascript")
    $(function() {
      $('form label').click(function () {
        $('form').removeClass('closed');
        $('input.invitation_code').focus();
      });
    });
  