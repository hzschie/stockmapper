extends website_template

block header_content
  title ETF Labs - Home
  
block nav_header
  .logo
    a(href='/')
      img(src='/images/domains/foreside/etflabs_logo.png', alt='')
      
block body_content
  #masthead.slide1 &nbsp;
  .main_content.login_page
    form.invite(action="/login", method="post")
      label Have an invitation code?
      .fields
        input(type="hidden", name="username", value="any")
        input(type="text", class="invitation_code", name="password", placeholder="Enter Code")
        input.go(type="submit", class="go", value="GO")
    h3.tagline
      | Welcome to
      br
      | the future of ETF's
