      .col
        h3 Market News
        #other_news
        script.
          $.ajax({
            url: '/news/EWZ,IWM,QQQ,VWO',
            success: function(data){
              var html = $.map(data, function(entry) {
                return [
                  '<a href="' + entry.href + '" target="_blank">',
                    '<h4>',
                      entry.title,
                    '</h4>',
                    '<div class="source">',
                      entry.source,
                    '</div>',
                  '</a>'
                ].join('');
              }).join('');
              $('#other_news').html(html);
            },
            error:function(){console.log('error');},
            dataType: 'JSON'
          });
