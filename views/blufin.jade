  .col
    dt P/E:
    dd.pe
    dt P/B:
    dd.pb
    dt P/S:
    dd.ps

block details_index_values
  .col
    dt Previous Close:
    dd.previous 123,456
    dt Volume:
    dd.volume 123,456
    dt Mkt. Cap:
