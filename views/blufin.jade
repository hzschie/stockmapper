block append inspector_content
  .content.index
    .header
      h3.category Amit was here
      .label Label
      .last_trade 123.45
      .change
        span.amount +12.34
    dl
      .wide
        dt Percent Change:
        dd.change
          span.percent 1.23%
        dt Previous Close:
        dd.previous 12.34
        dt Volume:
        dd.volume 123,456
        dt Mkt. Cap:
        dd.market_cap 123,456
        
