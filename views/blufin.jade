block append mobile_inspector_content
  .content.index
    .fixed
      .change
        span.amount
      .last_trade
      .label SYM
    dl.values
      .col
        dt Prev. Close:
        dd.previous 12.34
        dt Num Stocks Up:
        dd.num_up.green 123
        dt Num Stocks Down:
        dd.num_down.red 123
      .col
        dt Pct. Chg.:
        dd.change
          span.percent 1.23%
        dt Vol. Up:
        dd.volume_up.green 123,456
        dt Vol. Down:
        dd.volume_down.red 123,456
        dt Vol. Total:
        dd.volume_total 123,456

block analytics_code
  script(type='text/javascript')
    var _gaq = _gaq || [];
    _gaq.push(['_setAccount', '!{ analyticsCode || "UA-30725697-1" }']);
    _gaq.push(['_setDomainName', 'blufin.in']);
    _gaq.push(['_trackPageview']);
    (function() {
      var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
      ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
      var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
    })();

block help
  p 
    span.inline_h2 EquityWatch 
    | is a stock heat map, representing the performance of stocks listed on the NSE and BSE exchanges. The heat map renders the individual percent changes in market value for 800 stocks.


  h2 Filter & Sorting
  p The ﬁlter buttons on the top panel filter the stocks by logical groupings such as capitisation, industries and major indexes. The buttons are color coded according to the performance of the group. You can mouse over any button to get the trading volume of the group.

  h2 Sorting
  p The heat map can also be sorted by ticker symbol, price change, volume or market capitalization.

  h2 Stock Details, Graphs & News
  p You can mouse over any ticker symbol on the heat map to get market metrics for the selected stock such as the day's open, high/low and trading volume. Clicking on stock brings up a panel with charts and stock-related headlines with links to the individual news items.

  h2 Change/Volume Diagram
  p Upon selecting an individual stock group you will see a “bridge bar chart” of all stocks in the group with visual representation of price change and trading volume for easy evaluation the groups overall performance.
