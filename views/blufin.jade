block append inspector_content
  .content.index
    .header
      h3.type Amit was here
      .label Label
      .last_trade 123.45
      .change
        span.amount +12.34
    dl
      .wide
        dt Percent Change:
        dd.change
          span.percent 1.23%
        dt Previous Close:
        dd.previous 12.34
        dt Volume:
        dd.volume 123,456
        dt Market Cap 
          .unit (Cr.)
          | :
        dd.market_cap 123,456

block append mobile_inspector_content
  .content.index
    .fixed
      .label SYM
      .last_trade 123.45
      .change
        span.amount +12.34
    dl.values
      .col
        dt Prev. Close:
        dd.previous 12.34
        dt Num Stocks Up:
        dd.num_up.green 123
        dt Num Stocks Down:
        dd.num_down.red 123
      .col
        dt Pct. Chg.:
        dd.change
          span.percent 1.23%
        dt Vol. Up:
        dd.volume_up.green 123,456
        dt Vol. Down:
        dd.volume_down.red 123,456
        dt Vol. Total:
        dd.volume_total 123,456
