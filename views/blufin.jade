extends main

block page_title
  title EquityWatch

block metas
  meta(property="og:image", content="http://stockmapper-staging.herokuapp.com/images/blufin/og_image.png")
  
block links
  link(href='http://fonts.googleapis.com/css?family=Open+Sans+Condensed:700', rel='stylesheet', type='text/css')
  link(href='http://fonts.googleapis.com/css?family=EB+Garamond', rel='stylesheet', type='text/css')
  
block header
  .app_header
    #logo
      a(href="http://www.blufin.in/")
        img(width="130", height="33", src="http://www.blufin.in/BCI/images/blufin_logo.png", border="0")
    #logo-name EquityWatch
    #panel
      #global_last_update Last Update:&nbsp;&nbsp;
        span.value
      #help_button(onclick="mapper.Layout.toggleHelp();")
      a#refresh-bar(href="/")
      #social-icons
        ul
          li
            a(href="https://twitter.com/#!/BluFinIndia", title="twitter", class="twit", target="_blank")
          li
            a(href="https://www.facebook.com/pages/BluFinIndia/111282055662574", title="facebook", class="fb", target="_blank")
          li
            a(href="http://www.linkedin.com/company/blufin-india", title="linkedin", class="in", target="_blank")
          li
            a(href="http://www.youtube.com/user/BluFinIndia", title="youtube", class="ya", target="_blank")

block additional_panel_ui
  .coloring.dropdown_selector
    label
      .plus
      | Color By:
    .selection
      .display
      .panel.selector.disabled
        block coloring_options
          a(data-val="today") Today's change
          a(data-val="p1wk") 1wk change
          a(data-val="p1mo") 1mo change
          a(data-val="pYTD") YTD change
          a(data-val="p52wk") 52wk change
          a(data-val="p10yr") 10yr change

block append inspector_content
  .content.index
    .header
      h3.category Amit was here
      .label Label
      .last_trade 123.45
      .change
        span.amount +12.34
    dl
      .wide
        dt Percent Change:
        dd.change
          span.percent 1.23%
        dt Previous Close:
        dd.previous 12.34
        dt Volume:
        dd.volume 123,456
        dt Mkt. Cap:
        dd.market_cap 123,456
        
block append details_stock_values
  .col
    dt Div/Yield:
    dd.div_yield
    dt ROE:
    dd.roe
  .col
    dt P/E:
    dd.pe
    dt P/B:
    dd.pb
    dt P/S:
    dd.ps

block details_index_values
  .col
    dt Previous Close:
    dd.previous 123,456
    dt Volume:
    dd.volume 123,456
    dt Mkt. Cap:
    dd.market_cap 1.234B

block append mobile_inspector_content
  .content.index
    .fixed
      .change
        span.amount
      .last_trade
      .label SYM
    dl.values
      .col
        dt Prev. Close:
        dd.previous 12.34
        dt Num Stocks Up:
        dd.num_up.green 123
        dt Num Stocks Down:
        dd.num_down.red 123
      .col
        dt Pct. Chg.:
        dd.change
          span.percent 1.23%
        dt Vol. Up:
        dd.volume_up.green 123,456
        dt Vol. Down:
        dd.volume_down.red 123,456
        dt Vol. Total:
        dd.volume_total 123,456
        
block clustering_options
  a(data-val="none") None
  a(data-val="capitalization") Capitalization
  a(data-val="style") Style
  a(data-val="cross styles") Cross Styles
  a(data-val="sector") Sector

block analytics_code
  script(type='text/javascript')
    var _gaq = _gaq || [];
    _gaq.push(['_setAccount', '!{ analyticsCode || "UA-30725697-1" }']);
    _gaq.push(['_setDomainName', 'blufin.in']);
    _gaq.push(['_trackPageview']);
    (function() {
      var ga = document.createElement('script'); ga.type = 'text/javascript'; ga.async = true;
      ga.src = ('https:' == document.location.protocol ? 'https://ssl' : 'http://www') + '.google-analytics.com/ga.js';
      var s = document.getElementsByTagName('script')[0]; s.parentNode.insertBefore(ga, s);
    })();

block help
  p 
    span.inline_h2 EquityWatch 
    | is a stock heat map, representing the performance of the broad universe of Indian equities.  Use screens, highlighters and compare companies to identify and track stocks that match your investment needs or simply follow the latest news on companies. If you are an equity investor, the BluFin Stockmapper is the cutting edge app for all of your stock market tracking needs. For more information, <a href="http://www.blufin.in/equitywatch-faq.html">click here</a>.


  h2 Filter & Sorting
  p The ﬁlter buttons on the top panel filter the stocks by logical groupings such as capitisation, industries and major indexes. The buttons are color coded according to the performance of the group. You can mouse over any button to get the trading volume of the group.

  h2 Sorting
  p The heat map can also be sorted by ticker symbol, price change, volume or market capitalization.

  h2 Stock Details, Graphs & News
  p You can mouse over any ticker symbol on the heat map to get market metrics for the selected stock such as the day's open, high/low and trading volume. Clicking on stock brings up a panel with charts and stock-related headlines with links to the individual news items.

  h2 Change/Volume Diagram
  p Upon selecting an individual stock group you will see a “bridge bar chart” of all stocks in the group with visual representation of price change and trading volume for easy evaluation the groups overall performance.
