body.mobile
  header
    .back Back
    .logo
  .layout
    .index
      .groups_view
    .contents
      .group_info.details
        block mobile_inspector_content
          .content.group
            .label.fixed SYM
            dl.values
              .col
                dt Num Stocks Up:
                dd.num_up.green 123
                dt Num Stocks Down:
                dd.num_down.red 123
              .col
                dt Vol. Up:
                dd.volume_up.green 123,456
                dt Vol. Down:
                dd.volume_down.red 123,456
                dt Vol. Total:
                dd.volume_total 123,456
      .map_ui
        .sorts.selector
          label Sort By:
          a(data-val="sym") Symbol
          a(data-val="chg") & Change
          a(data-val="vol") Volume
          a(data-val="cap") Mkt Cap
      .map
        ul
    .details
      .left
        .quote
          .change
            span.amount
            | &nbsp;(
            span.percent
            | )
            .timestamp Last traded: 
              span.value
          .last_trade
        span.name
        |  
        span.sym
        .values
          dl
            .col
              dt Open:
              dd.open
              dt High:
              dd.high
              dt Low:
              dd.low
              dd &nbsp;
              dt
              dt P/E:
              dd.pe
              dt P/B:
              dd.pb
              dt P/S:
              dd.ps
            .col
              dt Avg. Vol.:
              dd.avg_volume
              dt Volume:
              dd.volume
              dt Market Cap:
              dd.market_cap
              dd &nbsp;
              dt
              dt Div/Yield:
              dd.div_yield
              dt ROE:
              dd.roe
        .graph
          .ui
            .ranges
              | Range:&nbsp;&nbsp;
              #r1d.range.selected 1d
              #r5d.range 5d
              #r3m.range 3m
              #r1y.range 1y
              #rMax.range Max
          svg
            defs
              linearGradient#fade(gradientTransform="rotate(90)", gradientUnits="userSpaceOnUse", spreadMethod="reflect")
                stop(offset="26%", stop-color="#FFF", stop-opacity=".09")
                stop(offset="28%", stop-color="#FFF", stop-opacity="0")
      .right
        .news
          .article
            a.title(target="stockmapper_news")
            span.source
            |  – 
            span.date
  .credit Designed and built by 
    a(href="http://www.two-n.com") TWO-N
  script(type='text/javascript')
    mapper.groupsJson = !{groups};
    mapper.stocksJson = !{stocks};