body.mobile
  .app_header
    .back Back
    .logo
  .layout
    .index
      .groups_view
    .contents
      .group_info.details
        block mobile_inspector_content
          .content.group
            .label.fixed SYM
            dl.values
              .col
                dt Num Stocks Up:
                dd.num_up.green 123
                dt Num Stocks Down:
                dd.num_down.red 123
              .col
                dt Vol. Up:
                dd.volume_up.green 123,456
                dt Vol. Down:
                dd.volume_down.red 123,456
                dt Vol. Total:
                dd.volume_total 123,456
      .map_ui
        .sorts.selector
          label Sort By:
          a(data-val="sym") Symbol
          a(data-val="chg") % Change
          a(data-val="vol") Volume
          a(data-val="cap") Mkt Cap
      .map
        ul
    .details.disabled
      .left
        .quote
          .change
            span.amount
            | &nbsp;(
            span.percent
            | )
            .timestamp Last traded: 
              span.value
          .last_trade
        .header
          span.name
          |  
          span.sym
        .values
          dl
            .col
              dt Open:
              dd.open &nbsp;
              dt High:
              dd.high &nbsp;
              dt Low:
              dd.low &nbsp;
              dt
              dd &nbsp;
              dt P/E:
              dd.pe &nbsp;
              dt P/B:
              dd.pb &nbsp;
              dt P/S:
              dd.ps &nbsp;
            .col
              dt Avg. Vol.:
              dd.avg_volume &nbsp;
              dt Volume:
              dd.volume &nbsp;
              dt Mkt. Cap:
              dd.market_cap &nbsp;
              dt
              dd &nbsp;
              dt Div/Yield:
              dd.div_yield &nbsp;
              dt ROE:
              dd.roe &nbsp;
        .graph
          .ui
            .ranges.selector
              | Range:&nbsp;&nbsp;
              a.range(data-val="r1d") 1d
              a.range(data-val="r5d") 5d
              a.range(data-val="r3m") 3m
              a.range(data-val="r1y") 1y
              a.range(data-val="rMax") Max
          svg
            defs
              linearGradient#fade(gradientTransform="rotate(90)", gradientUnits="userSpaceOnUse", spreadMethod="reflect")
                stop(offset="26%", stop-color="#FFF", stop-opacity=".09")
                stop(offset="28%", stop-color="#FFF", stop-opacity="0")
      .right
        .news
          .article
            a.title(target="stockmapper_news")
            span.source
            |  – 
            span.date
            
  a.credit(href="http://www.two-n.com", target="_blank")
    img(src="/images/2n_logo.png")
    .more Designed and <br>built by <b>TWO-N</b>

  script(type='text/javascript')
    mapper.groupsJson = !{groups};
    mapper.stocksJson = !{stocks};