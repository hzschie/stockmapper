body(style='padding:0 10px;', class=isTablet ? 'tablet' : null)
  include inspector
  block pre
  .wrapper
    .panel
      .inner
        block header
        .groups
          block panel_groups
        .views.selector
          a.disabled(data-val="index") INDEX
          a(data-val="map") MAP
          a(data-val="chart") CHART
        .search
          .field
            input(placeholder="Search")
            .x
          .search_dropdown
        .sorts.selector
          label Sort By:
          block sort_options
            a(data-val="sym") Ticker Symbol
            a(data-val="chg") Percent Change
            a(data-val="vol") Volume
            a(data-val="cap") Market Cap
        block additional_panel_ui

    opts = { id: 'stock_details', closeable: true, comparable: true }
    include details

    .layout
      block side_panels
        .help
          .close
          include help

      opts = { id: 'index_details', ro_volume: false, name_in_header: false, comparable: true }
      include details

      .map
        .title
          span.main
          span.sub
        .map_ui
          .clustering.dropdown_selector
            label
              .plus
              | Group By:
            .selection 
              .display
              .panel.selector.disabled
                block clustering_options
                  a(data-val="none") None
                  a(data-val="sector") Sector
                  a(data-val="region") Region
          .highlights.selector
            label
              .plus
              | Highlight:
            a(data-val="active") Very Active
            block highlights
              a.best(data-val="best") 52wk Best
              a.worst(data-val="worst") 52wk Worst
            
            .panel.disabled
              .content.active
                .info Ratio of 
                  span.metric volume
                  |  to 
                  span.metric average volume
                  |  greater than:
                input
                .slider
              .content.performance
                .info Ratio of 
                  span.metric current price
                  |  to 
                  span.metric
                    span.variable 52wk high
                    |  price
                  |   greater than:
                input
                .slider
                .periods.selector
                  a(data-val="p10yr") 10yr
                  a(data-val="p52wk") 52wk
                  a(data-val="pYTD") YTD
                  a(data-val="p1mo") 1mo
                  a(data-val="p1wk") 1wk
          block additional_map_ui
        ul
      .chart
        .ticks
        .bars
        .most_active
          .arrow
          .note VOLUME<br>Most Active Stock: 
            span.sym BIRLACOT
        .advances
          .arrow
          .note 
            span.count 203
            |  Stocks UP
          .arrow.right
        .declines
          .arrow
          .note 
            span.count 203
            |  Stocks DOWN
          .arrow.right

  //- a.credit(href="http://www.two-n.com", target="_blank")
  //-   img(src="/images/2n_logo.png")
  //-   .more Designed and <br>built by <b>TWO-N</b>

  block footer

  script(type='text/javascript')
    mapper.groupsJson = !{groups};
    mapper.stocksJson = !{stocks};