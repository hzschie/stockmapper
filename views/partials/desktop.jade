body(style='padding:0 10px;', class=isTablet ? 'tablet' : null)
  .panel
    block header
    .groups
    .views.selector
      a.disabled(data-val="index") INDEX
      a(data-val="map") MAP
      a(data-val="chart") CHART
    .search
      .field
        input(placeholder="Search")
        .x
      .search_dropdown
    .sorts.selector
      label Sort By:
      a(data-val="sym") Ticker Symbol
      a(data-val="chg") Percent Change
      a(data-val="vol") Volume
      a(data-val="cap") Market Cap
    .title
      
  
  #stock_details.details.disabled
    .left
      .header
        .quote
          .last_trade 123.45
          .change
            span.amount +12.34
            | &nbsp;(
            span.percent 1.23%
            | )
            .timestamp Last traded: 
              span.value Sep 24, 5:06PM EDT
        span.name Amit was here
        |  
        span.sym SYM
      .graph
        .ui
          .ranges.selector
            | Range:&nbsp;
            a.range(data-val="r1d") 1d
            a.range(data-val="r5d") 5d
            a.range(data-val="r3m") 3m
            a.range(data-val="r1y") 1y
            a.range(data-val="rMax") Max
          .slice
            span.time
            | Price: 
            span.price
            | Volume: 
            span.volume
        svg
          defs
            linearGradient#fade(gradientTransform="rotate(90)", gradientUnits="userSpaceOnUse", spreadMethod="reflect")
              stop(offset="21%", stop-color="#FFF", stop-opacity=".09")
              stop(offset="30%", stop-color="#FFF", stop-opacity="0")
      //- .compare Compare:
      //-   .search
      //-     .field
      //-       input(placeholder="Search")
      //-       .x
      //-     .search_dropdown
      //-   .selection

    .right
      .close
      .values
        dl
          .col
            dt Open:
            dd.open 12.34
            dt High:
            dd.high 12.34
            dt Low:
            dd.low 12.34
          .col
            dt Avg. Vol.:
            dd.avg_volume 123,456
            dt Volume:
            dd.volume 123,456
            dt Mkt. Cap:
            dd.market_cap 1.234B
          .col
            dt Div/Yield:
            dd.div_yield
            dt ROE:
            dd.roe
          .col
            dt P/E:
            dd.pe
            dt P/B:
            dd.pb
            dt P/S:
            dd.ps
      .news
        a.article(target="stockmapper_news")
          .title
          span.source
          |  – 
          span.date

  .layout
    .help
      .close
      include help

    #index_details.details.disabled
      .left
        .header
          .quote
            .last_trade 123.45
            .change
              span.amount +12.34
              | &nbsp;(
              span.percent 1.23%
              | )
              .timestamp Last traded: 
                span.value Sep 24, 5:06PM EDT
        .graph
          .ui
            .ranges.selector
              | Range:&nbsp;
              a.range.selected(data-val="r1d") 1d
              a.range(data-val="r5d") 5d
              a.range(data-val="r3m") 3m
              a.range(data-val="r1y") 1y
              a.range(data-val="rMax") Max
            .slice
              span.time
              | Price: 
              span.price
          svg
            defs
              linearGradient#fade(gradientTransform="rotate(90)", gradientUnits="userSpaceOnUse", spreadMethod="reflect")
                stop(offset="21%", stop-color="#FFF", stop-opacity=".09")
                stop(offset="30%", stop-color="#FFF", stop-opacity="0")
      .right
        .values
          dl
            .col
              dt Previous Close:
              dd.previous 123,456
              dt Volume:
              dd.volume 123,456
              dt Mkt. Cap:
              dd.market_cap 1.234B
        .news
          a.article(target="stockmapper_news")
            .title
            span.source
            |  – 
            span.date
      
    .map
      .map_ui
        .highlights.selector
          label
            .plus
            | Highlight:
          a(data-val="active") Very Active
          a.best(data-val="best") 52wk Best
          a.worst(data-val="worst") 52wk Worst
          .panel.disabled
            .content.active
              .info Ratio of 
                span.metric volume
                |  to 
                span.metric average volume
                |  greater than:
              input
              .slider
            .content.performance
              .info Ratio of 
                span.metric current price
                |  to 
                span.metric
                  span.variable 52wk high
                  |  price
                |   greater than:
              input
              .slider
              .periods.selector
                a(data-val="p10yr") 10yr
                a(data-val="p52wk") 52wk
                a(data-val="pYTD") YTD
                a(data-val="p1mo") 1mo
                a(data-val="p1wk") 1wk
      ul
    .chart
      .ticks
      .bars
      .most_active
        .arrow
        .note VOLUME<br>Most Active Stock: 
          span.sym BIRLACOT
      .advances
        .arrow
        .note 
          span.count 203
          |  Stocks UP
        .arrow.right
      .declines
        .arrow
        .note 
          span.count 203
          |  Stocks DOWN
        .arrow.right
        
  .inspector.hidden
    svg
      path(stroke="#ccc", fill="#fffdee")
    .body
    block inspector_content
      .content.stock
        .header
          h3.name Amit was here
          .sym SYM
          .last_trade 123.45
          .change
            span.amount +12.34
            | &nbsp;(
            span.percent 1.23%
            | )
        dl
          .left
            dt Avg. Vol.:
            dd.avg_volume 123,456
            dt Vol.:
            dd.volume 123,456
            dt MCap:
            dd.market_cap 1.234B
          .right
            dt Open:
            dd.open 12.34
            dt High:
            dd.high 12.34
            dt Low:
            dd.low 12.34
      .content.group
        .header
          h3.category Amit was here
          .label SYM
        dl
          .wide
            dt Num of Stocks Up:
            dd.num_up.green 123
            dt Num of Stocks Down:
            dd.num_down.red 123
            dt Volume Up:
            dd.volume_up.green 123,456
            dt Volume Down:
            dd.volume_down.red 123,456
            dt Volume Total:
            dd.volume_total 123,456
  .credit Designed and built by 
    a(href="http://www.two-n.com") TWO-N
  script(type='text/javascript')
    mapper.groupsJson = !{groups};
    mapper.stocksJson = !{stocks};