!!!
html
  head
    title= 'StockMapper'
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0")
    != renderStyles()
    script(type='text/javascript', src='https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js')
    script(type='text/javascript')
      mapper = {};
      mapper.config = !{dataConfig};
    script(type='text/javascript', src='/socket.io/socket.io.js')
    != renderJs()
  body(style='margin:10px;')
    .panel
    ul.map
    .chart
    .inspector.hidden
      svg
        path(stroke="#ccc", fill="#fffdee")
      .body
        .header
          h3.name Amit was here
          .sym SYM
          .last_trade 123.45
          .change
            span.amount +12.34
            &nbsp;\(
            span.percent 1.23%
            \)
        dl
          .left
            dt Avg. Vol.:
            dd.avg_volume 123,456
            dt Vol.:
            dd.volume 123,456
            dt Cap.:
            dd.market_cap 1.234B
          .right
            dt Open:
            dd.open 12.34
            dt High:
            dd.high 12.34
            dt Low:
            dd.low 12.34
