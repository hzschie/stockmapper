!!!
html
  head
    title= 'StockMapper'
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0")
    
    block links
      
    != renderStyles()
    
    script(type='text/javascript', src='https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js')
    script(type='text/javascript')
      mapper = {};
      mapper.config = !{dataConfig};
    script(type='text/javascript', src='/socket.io/socket.io.js')
    != renderJs()
    
  body(style='padding:0 10px;')
    .panel
      block header
      .groups
      .sorts
      .views
        a MAP
        a CHART
    
    .details(style="display:none;")
      .left
        .sym SYM
        .last_trade 123.45
        .change
          span.amount +12.34
          | &nbsp;(
          span.percent 1.23%
          | )
        h3.name Amit was here
        .graph
          .ui
            .ranges
              | Range:&nbsp;&nbsp;
              #rMax.range Max
              #r1y.range 1y
              #r3m.range 3m
              #r5d.range 5d
              #r1d.range.selected 1d
          svg
            defs
              linearGradient#fade(gradientTransform="rotate(90)", gradientUnits="userSpaceOnUse", spreadMethod="reflect")
                stop(offset="26%", stop-color="#FFF", stop-opacity=".09")
                stop(offset="28%", stop-color="#FFF", stop-opacity="0")
      .right
        .close
        .values
          dl
            .col
              dt Open:
              dd.open 12.34
              dt High:
              dd.high 12.34
              dt Low:
              dd.low 12.34
            .col
              dt Avg. Volume:
              dd.avg_volume 123,456
              dt Volume:
              dd.volume 123,456
              dt Market Cap:
              dd.market_cap 1.234B
            .col
              dt Div/Yield:
              dd.div_yield
              dt ROE:
              dd.roe
            .col
              dt P/E:
              dd.pe
              dt P/B:
              dd.pb
              dt P/S:
              dd.ps
        .news
          .article
            a.title(target="stockmapper_news")
            span.source
            |  – 
            span.date

    .layout
      ul.map
      .chart
        .ticks
        .bars
        .most_active
          .arrow
          .note VOLUME<br>Most Active Stock: 
            span.sym BIRLACOT
        .advances
          .arrow
          .note 
            span.count 203
            |  Stocks UP
          .arrow.right
        .declines
          .arrow
          .note 
            span.count 203
            |  Stocks DOWN
          .arrow.right
          
    .inspector.hidden
      svg
        path(stroke="#ccc", fill="#fffdee")
      .body
      block inspector_content
        .content.stock
          .header
            h3.name Amit was here
            .sym SYM
            .last_trade 123.45
            .change
              span.amount +12.34
              | &nbsp;(
              span.percent 1.23%
              | )
          dl
            .left
              dt Avg. Vol.:
              dd.avg_volume 123,456
              dt Vol.:
              dd.volume 123,456
              dt Cap.:
              dd.market_cap 1.234B
            .right
              dt Open:
              dd.open 12.34
              dt High:
              dd.high 12.34
              dt Low:
              dd.low 12.34
        .content.group
          .header
            h3.type Amit was here
            .label SYM
          dl
            .wide
              dt Num of Stocks Up:
              dd.num_up.green 123
              dt Num of Stocks Down:
              dd.num_down.red 123
              dt Volume Up:
              dd.volume_up.green 123,456
              dt Volume Down:
              dd.volume_down.red 123,456
              dt Volume Total:
              dd.volume_total 123,456