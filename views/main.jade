    script(type='text/javascript')
      // hello world
    script(type='text/javascript')
      (function() {
        return;
        // Open the original CSV file and extract stuff from it
        
        var stocks = {
              headers: ['id','name'],
              data: []
            },
            groups = [],
            groupsTable = {};
        
        $.ajax({
          url:'/data/stocks.csv',
          success: function(data) {
            var newline = data.charAt(58),
                rows = data.split(newline);
              
            for(var i = 1; i < rows.length; i++) {
              var vals = rows[i].split(','),
                  sym = vals[1];
              stocks.data.push([sym, vals[0]]);
              
              var industry = vals[2],
                  country = vals[6],
                  region = vals[7],
                  isSandP = vals[4] == 'YES',
                  isDow = vals[5] == 'YES';
                  
              getOrCreateGroup('industry', industry).ids.push(sym);
              getOrCreateGroup('country', country).ids.push(sym);
              getOrCreateGroup('region', region).ids.push(sym);
              
              if(isSandP) {
                getOrCreateGroup('index', 'S&P 500').ids.push(sym);
              }
              if(isDow) {
                getOrCreateGroup('index', 'Dow Jones').ids.push(sym);
              }
            }
          
            console.log(JSON.stringify(groups));
          }
        });
        
        function getOrCreateGroup(type, name) {
          var groupId = type + '_' + name;
              group = groupsTable[groupId];
          if(!group) {
            group = groupsTable[groupId] = {
              name: name,
              type: type,
              ids: []
            };
            
            groups.push(group);
          }
          
          return group;
        }
      })();
