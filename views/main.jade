!!!
html
  head
    title= 'StockMapper'
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0")
    
    block links
      
    != renderStyles()
    
    script(type='text/javascript', src='https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js')
    script(type='text/javascript')
      mapper = {};
      mapper.config = !{dataConfig};
    script(type='text/javascript', src='/socket.io/socket.io.js')
    != renderJs()
    
  body(style='margin:0 10px;')
    .panel
      block header
      .groups
      .sorts
      .views
        a MAP
        a CHART
    .chart
      .ticks
      .bars
      .most_active
        .arrow
        .note VOLUME<br>Most Active Stock: 
          span.sym BIRLACOT
      .advances
        .arrow
        .note 
          span.count 203
          |  Stocks UP
        .arrow.right
      .declines
        .arrow
        .note 
          span.count 203
          |  Stocks DOWN
        .arrow.right

    ul.map
    .inspector.hidden
      svg
        path(stroke="#ccc", fill="#fffdee")
      .body
      block inspector_content
        .content.stock
          .header
            h3.name Amit was here
            .sym SYM
            .last_trade 123.45
            .change
              span.amount +12.34
              | &nbsp;(
              span.percent 1.23%
              | )
          dl
            .left
              dt Avg. Vol.:
              dd.avg_volume 123,456
              dt Vol.:
              dd.volume 123,456
              dt Cap.:
              dd.market_cap 1.234B
            .right
              dt Open:
              dd.open 12.34
              dt High:
              dd.high 12.34
              dt Low:
              dd.low 12.34
        .content.group
          .header
            h3.type Amit was here
            .label SYM
          dl
            .wide
              dt Num of Stocks Up:
              dd.num_up.green 123
              dt Num of Stocks Down:
              dd.num_down.red 123
              dt Volume Up:
              dd.volume_up.green 123,456
              dt Volume Down:
              dd.volume_down.red 123,456
              dt Volume Total:
              dd.volume_total 123,456