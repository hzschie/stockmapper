!!!
html
  head
    title= 'StockMapper'
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0")
    
    link(rel='stylesheet', href='/stylesheets/boilerplate.css')
    link(rel='stylesheet', href='/stylesheets/main.css')
    link(rel='stylesheet', href='/stylesheets/panel.css')
    link(rel='stylesheet', href='/stylesheets/map.css')
    link(rel='stylesheet', href='/stylesheets/inspector.css')
    
    script(type='text/javascript')
      mapper = {};
      mapper.config = !{dataConfig};
    script(type='text/javascript', src='/javascripts/lib/zepto.min.js')
    script(type='text/javascript', src='/javascripts/lib/zepto.history.js')
    script(type='text/javascript', src='/javascripts/lib/underscore-min.js')
    script(type='text/javascript', src='/javascripts/lib/backbone-min.js')
    script(type='text/javascript', src='/javascripts/lib/d3.v2.min.js')
    script(type='text/javascript', src='/socket.io/socket.io.js')
    script(type='text/javascript', src='/javascripts/utils.js')
    script(type='text/javascript', src='/javascripts/stocks.js')
    script(type='text/javascript', src='/javascripts/viewstate.js')
    script(type='text/javascript', src='/javascripts/panel.js')
    script(type='text/javascript', src='/javascripts/map.js')
    script(type='text/javascript', src='/javascripts/chart.js')
    script(type='text/javascript', src='/javascripts/inspector.js')
    script(type='text/javascript', src='/javascripts/main.js')
  body(style='margin:10px;')
    .panel
    ul.map
    .chart
    .inspector.hidden
      svg
        path(stroke="#ccc", fill="#fffdee")
      .body
        .header
          h3.name Amit was here
          .sym SYM
          .last_trade 123.45
          .change
            span.amount +12.34
            &nbsp;\(
            span.percent 1.23%
            \)
        dl
          .left
            dt Avg. Vol.:
            dd.avg_volume 123,456
            dt Vol.:
            dd.volume 123,456
            dt Cap.:
            dd.market_cap 1.234B
          .right
            dt Open:
            dd.open 12.34
            dt High:
            dd.high 12.34
            dt Low:
            dd.low 12.34
