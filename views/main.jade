!!!
html
  head
    title= 'StockMapper'
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0")
    
    - if(dataDomain == 'blufin')
      link(href='http://fonts.googleapis.com/css?family=Open+Sans+Condensed:700', rel='stylesheet', type='text/css')
    != renderStyles()
    
    script(type='text/javascript', src='https://ajax.googleapis.com/ajax/libs/jquery/1.7.2/jquery.min.js')
    script(type='text/javascript')
      mapper = {};
      mapper.config = !{dataConfig};
    script(type='text/javascript', src='/socket.io/socket.io.js')
    != renderJs()
    
  body(style='margin:0 10px;')
    .panel
      .sorts
      .views
        div MAP
        div CHART
    ul.map
    .chart
    .inspector.hidden
      svg
        path(stroke="#ccc", fill="#fffdee")
      .body
      .content.stock
        .header
          h3.name Amit was here
          .sym SYM
          .last_trade 123.45
          .change
            span.amount +12.34
            | &nbsp;(
            span.percent 1.23%
            | )
        dl
          .left
            dt Avg. Vol.:
            dd.avg_volume 123,456
            dt Vol.:
            dd.volume 123,456
            dt Cap.:
            dd.market_cap 1.234B
          .right
            dt Open:
            dd.open 12.34
            dt High:
            dd.high 12.34
            dt Low:
            dd.low 12.34
      .content.group
        .header
          h3.type Amit was here
          .label SYM
        dl
          .wide
            dt Volume Up:
            dd.volume_up 123,456
            dt Volume Down:
            dd.volume_down 123,456
            dt Volume Total:
            dd.volume_total 123,456
      .content.index
        .header
          h3.name Amit was here
          .sym SYM
        dl
          .left
            dt Avg. Vol.:
            dd.avg_volume 123,456
            dt Vol.:
            dd.volume 123,456
          .right
            dt Open:
            dd.open 12.34
            dt High:
            dd.high 12.34
