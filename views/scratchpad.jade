!!!
html
  head
    title= 'Scratch Pad'
    meta(name="viewport", content="width=device-width, initial-scale=1.0, maximum-scale=1.0")
    
    style(type="text/css")
      body { background-color:#fcc; }
      .tree div { position:absolute; left:-1px; top:-1px; background:rgba(255,0,0,.2); border:1px solid; }
      
    script(type='text/javascript', src='/javascripts/lib/jquery-1.7.2.min.js')
    script(type='text/javascript', src='/javascripts/lib/underscore-min.js');
    script(type='text/javascript', src='/javascripts/lib/backbone-min.js');
    script(type='text/javascript', src='/javascripts/lib/d3.v2.min.js');
    
    script(type='text/javascript')
      mapper = {
        config: {}
      };
      mapper.groupsJson = !{groups};
      mapper.stocksJson = !{stocks};

    script(type='text/javascript', src='/javascripts/interval.js');
    script(type='text/javascript', src='/javascripts/stocks.js');
    script(type='text/javascript', src='/javascripts/init_data.js');
            
    script(type='text/javascript')
      mapper.dataReady = function() {
        //var nester = d3.nest().key(function(stock)
        var VERT = 0, HORZ = 1,
            uw = 64, uh = 14,
            category = "Industry",//"Capitisation",//
            groups = mapper.groups.where({ category: category });
        
        // groups.sort(function(a, b) {
        //   var na = a.get('members').length,
        //       nb = b.get('members').length;
        //   return (na < nb) - (nb < na);
        // });
        function generateBinTree(groups, memo) {
          var memo = memo || {};
          memo.n = d3.sum(groups, function(group) { return group.get('members').length; });
          if(groups.length == 1) return memo.g = groups[0];
          else memo.t = [{},{}];
          
          for(var i = 0, count = 0, split = [[],[]], len = groups.length; i < len; i++) {
            var group = groups[i],
                numMembers = group.get('members').length;
            
            if(count + numMembers/2 <= memo.n / 2) split[0].push(group);
            else split[1].push(group);
            
            count += numMembers;
          }
          
          generateBinTree(split[0], memo.t[0]);
          generateBinTree(split[1], memo.t[1]);
          
          return memo;
        }
        
        var tree = generateBinTree(groups)
        gridifyBinTree(tree, 15);
        console.log(tree);
        
        function gridifyBinTree(tree, gridW) {
          tree.gw = gridW;
          tree.gh = Math.ceil(tree.n / tree.gw);
          
          if(tree.g) { return tree.gh; }
          
          var f0 = tree.t[0].n / tree.n,
              f1 = tree.t[1].n / tree.n;
          
          tree.Igh = tree.gh;
          if( (tree.gw * uw) / (tree.gh * uh) < 2 || Math.round(Math.min(f0 * tree.gw, f1 * tree.gw)) < 3) {//uw/uh) {
            tree.stack = VERT;
            tree.gh = gridifyBinTree(tree.t[0], tree.gw) + gridifyBinTree(tree.t[1], tree.gw);
          }
          else {
            tree.stack = HORZ
            tree.gh = Math.max( gridifyBinTree(tree.t[0], Math.round(f0 * tree.gw)), gridifyBinTree(tree.t[1], Math.round(f1 * tree.gw)) );
          }
          return tree.gh;
        }
        
        function renderBinTreeGrid(tree, $container) {
          $container.css({
            width: tree.gw * uw,
            height: tree.gh * uh
          });
          
          if(tree.g) return $container.text(tree.g.get('nickname') + " " + tree.gw + 'x' + tree.gh + '(' + (Math.round(100*tree.n/tree.gw) / 100) + ')');
          
          if(tree.stack == VERT) {
            renderBinTreeGrid(tree.t[0], $('<div></div>').appendTo($container));
            renderBinTreeGrid(tree.t[1], $('<div></div>').css({ top:tree.t[0].gh * uh - 1 }).appendTo($container));
          }
          else {
            renderBinTreeGrid(tree.t[0], $('<div></div>').appendTo($container));
            renderBinTreeGrid(tree.t[1], $('<div></div>').css({ left:tree.t[0].gw * uw - 1 }).appendTo($container));
          }
        }
        
        function renderBinTree(tree, $container) {
          if(tree.g) return $container.text(tree.g.get('nickname') + " " + tree.gw + 'x' + tree.gh + '(' + (tree.n/tree.gw) + ')');
          
          var w = $container.width(),
              h = $container.height(),
              $c0 = $('<div></div>').appendTo($container),
              $c1 = $('<div></div>').appendTo($container),
              f0 = tree.t[0].n / tree.n,
              f1 = tree.t[1].n / tree.n,
              temp;
          
          if(h > w) {
            $c0.css({
              width: w,
              height: temp = f0 * h
            });
            $c1.css({
              top: temp - 1,
              width: w,
              height: f1 * h
            });
          }
          else {
            $c0.css({
              width: temp = f0 * w,
              height: h
            });
            $c1.css({
              left: temp - 1,
              width: f1 * w,
              height: h
            });
          }
          
          renderBinTree(tree.t[0], $c0);
          renderBinTree(tree.t[1], $c1);
        }
        
        // renderBinTree(tree, $('<div class="tree" style="width:600px; height:900px;"></div>').appendTo($('body')));
        renderBinTreeGrid(tree, $('<div class="tree"></div>').appendTo($('body')));
      };

body