extends main

block header
  .app_header
    .logo StockMapper
    a(href="javascript:void(0)", onclick="mapper.Layout.toggleAbout();") ABOUT
    a(href="javascript:void(0)", onclick="mapper.Layout.toggleHelp();") HELP

    a(href="https://twitter.com/share", class="twitter-share-button", data-text="Animated market heatmaps", data-via="2nfo", data-count="none") Tweet
    script(type='text/javascript')
      !function(d,s,id){var js,fjs=d.getElementsByTagName(s)[0];if(!d.getElementById(id)){js=d.createElement(s);js.id=id;js.src="//platform.twitter.com/widgets.js";fjs.parentNode.insertBefore(js,fjs);}}(document,"script","twitter-wjs");
    
    .about
      .left
        p.main A platform for presenting and classifying large collections of stocks or other financial instruments, providing an at-a-glance heatmap view of the market, alongside detailed quotes, news feeds and historical graphs.
        p Looking for the old, Flash-based prototypes of Stockmapper? You can still <a href="http://prototypes.stockmapper.com">access them here</a>.
      .right
        p Stockmapper is designed and developed by <a href="http://two-n.com" target="_blank">TWO-N inc,</a> a New York -based data visualization agency. The version you are viewing consists of the components of the NYA Index –– a collection of 1800 stocks traded on the New York Stock Exchange –– but Stockmapper can be configured and restyled to display any collection of financial instruments. For example, here's <a href="http://equitywatch.blufin.in">a version covering India's stock markets</a>, created for BluFin India, a Mumbai-based financial information company. For inquiries, <a href="mailto:inquiries@two-n.com">contact TWO-N</a>.
        p.disclaimer DISCLAIMER: Market data used in the maps is 20 minutes delayed and for informational purposes only. All trademarks and copyrights remain the property of their respective owners. Concept and development by TWO-N, INC. | All rights reserved.
      

block append inspector_content
  .content.index
    .header
      h3.name Amit was here
      .sym SYM
      .last_trade 123.45
      .change
        span.amount +12.34
        | &nbsp;(
        span.percent 1.23%
        | )
    dl
    .wide
        dt Previous Close:
        dd.previous 12.34
        dt Num of Stocks Up:
        dd.num_up.green 123
        dt Num of Stocks Down:
        dd.num_down.red 123
        dt Volume Up:
        dd.volume_up.green 123,456
        dt Volume Down:
        dd.volume_down.red 123,456
        dt Volume Total:
        dd.volume_total 123,456

